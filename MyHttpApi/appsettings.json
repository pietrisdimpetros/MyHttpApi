{
  // 1. APP IDENTITY (Used by Hosting to configure Security, Docs, & Logs)
  "App": {
    "Name": "OrdersApi",
    "Version": "v1.0",
    "Domain": "your-tenant.onmicrosoft.com",
    "TenantId": "your-azure-tenant-guid",
    "ClientId": "your-api-app-registration-id",
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://my-frontend.azurewebsites.net"
    ]
  },

  // 2. DATABASE (Used by Shared.Data)
  // This must exist because we call builder.Services.AddDatabaseInfrastructure()
  "Database": {
    "ConnectionString": "Server=localhost;Database=OrdersDb;Trusted_Connection=True;TrustServerCertificate=True;",
    "MaxRetryCount": 3,
    "CommandTimeoutSeconds": 30
  },

  // 3. EXTERNAL API (Used by Shared.ExternalIntegration)
  // Only needed if you use AddExternalIntegration()
  "ExternalApi": {
    "BaseUrl": "https://api.shipping-partner.com",
    "OcpApimSubscriptionKey": "secret-key-123",
    "IdentityProvider": {
      "TokenUrl": "https://login.microsoftonline.com/partner-tenant/oauth2/v2.0/token",
      "ClientId": "service-account-client-id",
      "ClientSecret": "service-account-secret",
      "Scope": "api://shipping-api/.default"
    },
    "Resilience": {
      "TotalRequestTimeoutSeconds": 30,
      "CircuitBreakerFailureThreshold": 0.5
    }
  },

  // 4. LOGGING (Used by Shared.Logging)
  // Hosting automatically maps "Logging:Enterprise:ApplicationName" from "App:Name"
  "Logging": {
    "Enterprise": {
      "UseJsonFormat": false, // False = Human readable (Dev), True = JSON (Prod)
      "EnableCustomRequestLogging": true
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning" // Mute default request logs
    }
  },

  // 5. CACHING (Used by Shared.Caching)
  "Caching": {
    "InstanceName": "OrdersApi:", // Prefix for Redis keys
    "DefaultExpirationMinutes": 60
  },

  // 6. OBSERVABILITY (Used by Shared.Observability)
  "AzureMonitor": {
    "ConnectionString": "InstrumentationKey=..."
  }
}